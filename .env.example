# ============================================================
#  BLACKBRO — variables de entorno
# ------------------------------------------------------------
#  Copia este archivo a `.env` y pon ahí la key de verdad:
#
#      cp .env.example .env
#
#  `.env` está en .gitignore: NO se sube al repositorio, NUNCA.
#  Este archivo (`.env.example`) sí se sube, pero sin ninguna key:
#  sirve para que cualquiera sepa qué variables hacen falta.
#
#  EN PRODUCCIÓN ESTE ARCHIVO NO SE USA. En el sitio publicado las
#  variables se cargan en Netlify > Site configuration >
#  Environment variables, y sólo las ve quien entra a esa cuenta.
# ============================================================

# La API Key del Chatflow de BLACKBRO en Dify. Empieza por "app-".
DIFY_API_KEY=

# Sólo si el Chatflow NO vive en la nube pública de Dify.
# Con api.dify.ai no hace falta tocar esta línea.
# DIFY_API_BASE=https://tu-instancia/v1
